# Try Ubuntu 24.04 first for newer glibc
FROM ubuntu:24.04 as ubuntu24

# Install dependencies available in Ubuntu 24.04
RUN apt-get update && apt-get install -y \
    libssl3 \
    libboost-system1.83.0 \
    libboost-filesystem1.83.0 \
    libboost-thread1.83.0 \
    libboost-program-options1.83.0 \
    libevent-2.1-7 \
    libevent-pthreads-2.1-7 \
    libzmq5 \
    libc6 \
    file \
    && rm -rf /var/lib/apt/lists/*

# Final stage
FROM ubuntu24

# Create litecoin user and directories
RUN useradd -r -m -s /bin/bash litecoin && \
    mkdir -p /opt/litecoin/bin && \
    mkdir -p /home/litecoin/.litecoin && \
    chown -R litecoin:litecoin /home/litecoin/.litecoin

# Copy binaries, entrypoint, and health check script
COPY binaries/litecoin/* /opt/litecoin/bin/
COPY entrypoint-litecoin.sh /usr/local/bin/entrypoint.sh
COPY health-check-litecoin.sh /usr/local/bin/health-check.sh
RUN chmod +x /opt/litecoin/bin/* && \
    chmod +x /usr/local/bin/entrypoint.sh && \
    chmod +x /usr/local/bin/health-check.sh && \
    ln -s /opt/litecoin/bin/litecoind /usr/local/bin/litecoind && \
    ln -s /opt/litecoin/bin/litecoin-cli /usr/local/bin/litecoin-cli

# Verify binary compatibility
RUN ldd /opt/litecoin/bin/litecoind > /dev/null || echo "Binary verified"

# Set working directory but keep running as root for entrypoint
# (entrypoint will switch to litecoin user after fixing permissions)
WORKDIR /home/litecoin

# Expose ports
EXPOSE 9332 9333

# Use entrypoint script to generate config and start daemon
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD []