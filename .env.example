# Litecoin Configuration
LTC_RPC_USER=litecoin_user
LTC_RPC_PASS=change_this_secure_password
LTC_RPC_PORT=9332
LTC_P2P_PORT=9333

# Litecoin Pruning (optional - saves disk space)
# Set to 0 to disable pruning (full node)
# Set to a value in MB to enable pruning (minimum 550 MB)
# Example: LTC_PRUNE=10000 for ~10GB max blockchain size
LTC_PRUNE=0

# Meowcoin Configuration
MEWC_RPC_USER=meowcoin_user
MEWC_RPC_PASS=change_this_secure_password
MEWC_RPC_PORT=8766
MEWC_P2P_PORT=8767

# Meowcoin Pruning (optional - saves disk space)
# Set to 0 to disable pruning (full node)
# Set to a value in MB to enable pruning (minimum 550 MB)
# Example: MEWC_PRUNE=2000 for ~2GB max blockchain size
MEWC_PRUNE=0

# Dogecoin Configuration
DOGE_RPC_USER=dogecoin_user
DOGE_RPC_PASS=change_this_secure_password
DOGE_RPC_PORT=22555
DOGE_P2P_PORT=22556

# Dogecoin Pruning (optional - saves disk space)
# Set to 0 to disable pruning (full node)
# Set to a value in MB to enable pruning (minimum 550 MB)
# Example: DOGE_PRUNE=10000 for ~10GB max blockchain size
# Note: Dogecoin blockchain is large (~80GB+), pruning highly recommended
DOGE_PRUNE=0

# Wallet Addresses (UPDATE THESE WITH YOUR ACTUAL ADDRESSES)

# Litecoin address (OPTIONAL - first miner connection will set the payout address)
# The miner's username (address) becomes the payout address automatically
# You can uncomment this to document your intended address:
# LTC_WALLET_ADDRESS=ltc1youraddresshere or LYourAddressHere

# ==============================================================================
# AUXILIARY CHAIN CONFIGURATION - Choose Your Merge Mining Mode
# ==============================================================================
# Leave ALL auxiliary addresses blank for: LTC ONLY (no merge mining)
# Set DOGE_WALLET_ADDRESS only for:      LTC + DOGE merge mining
# Set MEWC_WALLET_ADDRESS only for:      LTC + MEWC merge mining  
# Set BOTH addresses for:                LTC + DOGE + MEWC triple mining
# ==============================================================================

# Dogecoin address (OPTIONAL - for AuxPoW merge mining with Dogecoin)
# Set to your Dogecoin address to enable LTC+DOGE merge mining
DOGE_WALLET_ADDRESS=

# Meowcoin address (OPTIONAL - for AuxPoW merge mining with Meowcoin)
# Set to your Meowcoin address to enable LTC+MEWC merge mining
MEWC_WALLET_ADDRESS=

# Stratum Proxy Configuration
STRATUM_PORT=50000
TESTNET=false
VERBOSE=true
SHOW_JOBS=true

# Proxy Configuration
# Custom signature to identify this proxy in coinbase transactions
# Keep it short (max 32 bytes recommended) and unique to your setup
PROXY_SIGNATURE=/your-pool-name/

# Advanced Settings (optional)
# Network Settings - uncomment and modify if needed
# LTC_RPC_HOST=192.168.0.100  # Override LTC RPC host (alternative: LTC_RPC_IP)
# MEWC_RPC_HOST=192.168.0.100  # Override MEWC RPC host (alternative: MEWC_RPC_IP)

# Mining Optimization
# Enable easier target selection between LTC and MEWC for better mining efficiency
USE_EASIER_TARGET=true

# Share difficulty divisor (controls how often miners submit shares)
# Formula: share_difficulty = network_difficulty / SHARE_DIFFICULTY_DIVISOR
# HIGHER value = EASIER shares = MORE frequent submissions
# LOWER value = HARDER shares = LESS frequent submissions
# 1.0 = network difficulty (only blocks submitted, no intermediate shares)
# 1000.0 = default balanced setting (recommended for production)
# 10000.0 = very easy shares, frequent submissions (good for testing/stats)
SHARE_DIFFICULTY_DIVISOR=1000.0

# For testnet operation (uncomment to enable)
# TESTNET=true

# ZMQ Configuration (for real-time block notifications)
# Enable ZMQ for better performance and immediate block updates
ENABLE_ZMQ=true                            # Enable/disable ZMQ
LTC_ZMQ_ENDPOINT=tcp://litecoin:28332      # LTC ZMQ endpoint
DOGE_ZMQ_ENDPOINT=tcp://dogecoin:28444     # DOGE ZMQ endpoint
MEWC_ZMQ_ENDPOINT=tcp://meowcoin:28433     # MEWC ZMQ endpoint

# ZMQ Port Configuration
LTC_ZMQ_PORT=28332                         # LTC ZMQ hashblock port
LTC_ZMQ_RAW_PORT=28333                     # LTC ZMQ rawblock port  
DOGE_ZMQ_PORT=28444                        # DOGE ZMQ hashblock port
DOGE_ZMQ_RAW_PORT=28445                    # DOGE ZMQ rawblock port
MEWC_ZMQ_PORT=28433                        # MEWC ZMQ hashblock port
MEWC_ZMQ_RAW_PORT=28434                    # MEWC ZMQ rawblock port

# Logging levels
# VERBOSE=false  # Set to false for less verbose output
# SHOW_JOBS=false  # Set to false to hide job notifications
# DEBUG_SHARES=false  # Set to true to log all share submissions (including low difficulty)